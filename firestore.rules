rules_version = '2';
// 送件：公開訪客只能「新增」，不能讀、改、刪；管理員可讀、改（審核）、刪。
// 網站內容（site / merchants / slides / deals / articles）：公開只能讀「已發布／啟用」的；只有管理員能寫，且必須帶 updatedAt / updatedBy 稽核欄位。
// 管理員 = custom claim admin==true（視為 owner），或 admins/{uid} 文件（role: owner | editor）。
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc() { return get(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function hasAdminDoc() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function isOwner() { return signedIn() && (request.auth.token.admin == true || (hasAdminDoc() && adminDoc().data.role == 'owner')); }
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || (hasAdminDoc() && adminDoc().data.role in ['owner', 'editor'])); }
    function audited() { return request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time; }
    function contentWrite() { return isAdmin() && audited() && request.resource.data.size() <= 60; }
    function str(f, min, max) { return request.resource.data[f] is string && request.resource.data[f].size() >= min && request.resource.data[f].size() <= max; }
    function optStr(f, max) { return !request.resource.data.keys().hasAny([f]) || str(f, 0, max); }
    function tel(f) { return request.resource.data[f].matches('^\\+?[0-9 ()-]{7,20}$'); }
    function base() {
      return request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.consent == true
        && request.resource.data.lang in ['tw', 'cn', 'en'];
    }
    match /submissions_business/{id} {
      allow create: if base()
        && request.resource.data.keys().hasOnly(['bname','category','address','phone','whatsapp','hours','desc','consent','photoPath','lang','status','createdAt'])
        && request.resource.data.keys().hasAll(['bname','category','address','phone','hours','desc','consent','lang','status','createdAt'])
        && str('bname', 1, 120) && request.resource.data.category in ['food','grocery','services','health','other']
        && str('address', 1, 300) && str('phone', 7, 20) && tel('phone')
        && optStr('whatsapp', 20) && (request.resource.data.get('whatsapp', '') == '' || tel('whatsapp'))
        && str('hours', 1, 200) && str('desc', 1, 500)
        && (!request.resource.data.keys().hasAny(['photoPath']) || (request.resource.data.photoPath is string && request.resource.data.photoPath.matches('^uploads/business/[0-9a-f-]{36}\\.(jpg|png|webp)$')));
      allow read, delete: if isAdmin();
      allow update: if reviewOnly();
    }
    match /submissions_advertise/{id} {
      allow create: if base()
        && request.resource.data.keys().hasOnly(['name','business','email','phone','plan','message','consent','lang','status','createdAt'])
        && request.resource.data.keys().hasAll(['name','business','email','consent','lang','status','createdAt'])
        && str('name', 1, 100) && str('business', 1, 120)
        && str('email', 3, 200) && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && optStr('phone', 20) && (request.resource.data.get('phone', '') == '' || tel('phone'))
        && request.resource.data.get('plan', '') in ['', 'basic', 'standard', 'bundle']
        && optStr('message', 1000);
      allow read, delete: if isAdmin();
      allow update: if reviewOnly();
    }
    match /submissions_giveaway/{id} {
      allow create: if base()
        && request.resource.data.keys().hasOnly(['name','whatsapp','consent','marketing','lang','status','createdAt'])
        && request.resource.data.keys().hasAll(['name','whatsapp','consent','marketing','lang','status','createdAt'])
        && str('name', 1, 100) && str('whatsapp', 9, 20) && tel('whatsapp')
        && request.resource.data.marketing is bool;
      allow read, delete: if isAdmin();
      allow update: if reviewOnly();
    }
    // 審核：只能改 status / note / reviewedAt / reviewedBy / merchantId，原始送件內容不可改
    function reviewOnly() {
      return isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'reviewedAt', 'reviewedBy', 'merchantId'])
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
    }
    match /site/{docId} {
      allow read: if true;
      allow create, update: if contentWrite() && docId in ['settings', 'advertise', 'giveaway'];
      allow delete: if isOwner();
    }
    match /merchants/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if contentWrite() && request.resource.data.published is bool && request.resource.data.name.tw is string;
      allow delete: if isAdmin();
    }
    match /slides/{id} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow create, update: if contentWrite() && request.resource.data.enabled is bool;
      allow delete: if isAdmin();
    }
    match /deals/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if contentWrite() && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }
    match /articles/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if contentWrite() && request.resource.data.published is bool && request.resource.data.page in ['life', 'guides'];
      allow delete: if isAdmin();
    }
    // 管理員名單：本人可讀自己的（知道自己角色）；只有 owner 能新增／改／刪
    match /admins/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isOwner();
      allow create, update: if isOwner() && request.resource.data.role in ['owner', 'editor'] && audited();
      allow delete: if isOwner() && uid != request.auth.uid;
    }
    // 商家統計：公開訪客只能「小量遞增」計數欄位，不能讀、不能刪、不能寫其他欄位。不存任何個資。
    // 文件 ID = 商家ID_YYYYMMDD。上限需與 assets/stats.js 的 MAX 同步。
    function statKeys() { return ['views', 'click_whatsapp', 'click_call', 'click_website', 'dwell_ms_total', 'dwell_samples']; }
    function incOk(f, max, old) {
      return !request.resource.data.keys().hasAny([f])
        || (request.resource.data[f] is int && request.resource.data[f] - old >= 0 && request.resource.data[f] - old <= max);
    }
    function statsOk(isNew) {
      return incOk('views', 50, isNew ? 0 : resource.data.get('views', 0))
        && incOk('click_whatsapp', 20, isNew ? 0 : resource.data.get('click_whatsapp', 0))
        && incOk('click_call', 20, isNew ? 0 : resource.data.get('click_call', 0))
        && incOk('click_website', 20, isNew ? 0 : resource.data.get('click_website', 0))
        && incOk('dwell_ms_total', 600000, isNew ? 0 : resource.data.get('dwell_ms_total', 0))
        && incOk('dwell_samples', 50, isNew ? 0 : resource.data.get('dwell_samples', 0));
    }
    match /stats_daily/{id} {
      allow read: if isAdmin();
      allow create: if id.matches('^[A-Za-z0-9_-]{1,60}_[0-9]{8}$')
        && request.resource.data.keys().hasOnly(statKeys()) && statsOk(true);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(statKeys()) && statsOk(false);
      allow delete: if isOwner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
